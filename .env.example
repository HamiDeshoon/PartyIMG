# VPS Deployment Environment Variables

NODE_ENV=production
PORT=3000

# Admin Portal Password (Login with username: 'Theomainie')
ADMIN_USERNAME=Theomainie
ADMIN_PASSWORD=19981998

# JWT/Session Secret (Use a strong random string)
SESSION_SECRET=super_secret_wedding_production_key_123

# Gemini API Key (Optional: for AI Wedding Recap generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Pino Logger Level
LOG_LEVEL=info

# Cloudflare R2 Settings (Option A)
USE_R2=false
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=partyimg-uploads
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev